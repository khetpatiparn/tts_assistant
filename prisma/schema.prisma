// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CorePrompt {
  id        String        @id @default(cuid())
  label     String
  content   String
  isActive  Boolean       @default(false)
  kind      String        @default("core")
  createdAt DateTime      @default(now())
  entries   PromptEntry[]
}

model PromptEntry {
  id          String   @id @default(cuid())
  productName String
  productInfo String
  riskModule  String
  extraNotes  String
  angle       String   @default("")
  productSpec String   @default("")
  images      String
  createdAt   DateTime @default(now())
  duplicatedFromId String?

  corePromptId   String?
  corePrompt     CorePrompt? @relation(fields: [corePromptId], references: [id])
  chatgptOutput  String      @default("")
  videoUrl       String      @default("")
  postedAt       DateTime?
  productImages  ProductImage[]
  caption        String      @default("")
  hashtags       String      @default("")
  affiliateOrders AffiliateOrder[]
  postedTimeOfDay String?
  postedTimeSource String?
  isScheduledPost  Boolean @default(false)
  clipMetrics     ClipMetric[]
}

model ProductImage {
  id        String      @id @default(cuid())
  entryId   String
  entry     PromptEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  caption   String      @default("")
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
}

model AffiliateOrder {
  orderId          String       @id
  productName      String
  productId        String
  contentId        String
  status           String
  currency         String
  gmv              Float
  itemsSold        Int
  itemsRefunded    Int
  actualCommission Float?
  finalRevenue     Float?
  orderDate        DateTime
  matchedEntryId   String?
  matchedEntry     PromptEntry? @relation(fields: [matchedEntryId], references: [id], onDelete: SetNull)
  importedAt       DateTime     @default(now())

  @@index([contentId])
  @@index([orderDate])
}

model VideoThumbnail {
  contentId    String   @id
  thumbnailUrl String?
  title        String?
  ok           Boolean  @default(false)
  fetchedAt    DateTime @default(now())
}

model ClipMetric {
  id             String       @id @default(cuid())
  videoId        String
  matchedEntryId String?
  matchedEntry   PromptEntry? @relation(fields: [matchedEntryId], references: [id], onDelete: SetNull)
  title          String
  postedDate     String
  views          Int
  likes          Int
  comments       Int
  shares         Int
  capturedOn     DateTime
  importedAt     DateTime     @default(now())

  @@unique([videoId, capturedOn])
  @@index([matchedEntryId])
}

model FollowerActivity {
  id         String   @id @default(cuid())
  activityOn DateTime
  hour       Int
  active     Int
  importedAt DateTime @default(now())

  @@unique([activityOn, hour])
}

/// บันทึก 1 แถวต่อ 1 ไฟล์ที่อัปสำเร็จ — ตอบว่า "รอบนี้อัปอะไรไปแล้วบ้าง" ให้รอด refresh
///
/// ต่างจาก importedAt ในตารางข้อมูลตรงที่ importedAt บอกได้แค่ "ล่าสุดเมื่อไร" ไม่บอกว่ากี่ไฟล์
/// ซึ่งเป็นปัญหากับ Content.csv ที่ต้องอัป 3 ไฟล์ต่อรอบและทั้งสามเขียนลง capturedOn เดียวกัน
model ImportLog {
  id         String   @id @default(cuid())
  /// "orders" | "clips" | "followers"
  kind       String
  /// timestamp จริง (ไม่ใช่ UTC midnight) — ตัดวันด้วย local getter เสมอ
  uploadedAt DateTime @default(now())
  /// sha256 ของไฟล์ดิบ ใช้ตรวจว่าอัปไฟล์เดิมซ้ำ
  fileHash   String
  rowCount   Int
  /// ลายเซ็นให้ผู้ใช้ดูออกว่าไฟล์ไหนคือไฟล์ไหน เช่น "15 คลิป · เก่าสุด 1 ก.ค."
  summary    String

  @@index([kind, uploadedAt])
  @@index([fileHash])
}
